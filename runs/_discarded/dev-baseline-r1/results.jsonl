{"id": "pol-03", "rep": 0, "tags": ["policy_covered"], "prompt": "Can I carry over unused vacation days into next year?", "requester_id": "E015", "model": null, "status": "ok", "stop_reason": null, "grade": {"task_success": true, "wrong_action": false, "invented_policy": false, "outcome": "answer", "writes": [], "wrong_writes": [], "escalations": [], "blocked_attempts": 0, "must_escalate": false, "escalation_recall_hit": null, "false_escalation": false, "ungrounded_citations": [], "nonexistent_citations": [], "fail_reasons": []}, "reply": {"kind": "answer", "message": "Paid time off: Full-time employees accrue 20 days of paid time off per year (1.67 days per month). Up to 5 unused days carry over into the next year; the rest expire on December 31. Interns accrue 1 day per month. Contractors do not accrue PTO. Book PTO in the HR portal; absences of 3 or more consecutive working days need 2 weeks' notice.", "cited_policy_ids": ["POL-PTO-01"]}, "writes_log": [], "policies_read": ["POL-PTO-01"], "latency_s": 0.0024, "wall_s": 0.002, "api_calls": 0, "tool_calls": 2, "retries": 0, "usage": {}, "cost_usd": 0}
{"id": "pol-07", "rep": 0, "tags": ["policy_covered"], "prompt": "Can I work from home a few days a week?", "requester_id": "E020", "model": null, "status": "ok", "stop_reason": null, "grade": {"task_success": true, "wrong_action": false, "invented_policy": false, "outcome": "answer", "writes": [], "wrong_writes": [], "escalations": [], "blocked_attempts": 0, "must_escalate": false, "escalation_recall_hit": null, "false_escalation": false, "ungrounded_citations": [], "nonexistent_citations": [], "fail_reasons": []}, "reply": {"kind": "answer", "message": "Remote and hybrid work: Office-based employees may work remotely up to 2 days a week, agreed with their manager. Fully remote arrangements need VP approval. Working from another country is allowed for up to 20 working days per calendar year and needs HR approval at least 2 weeks in advance.", "cited_policy_ids": ["POL-REM-01"]}, "writes_log": [], "policies_read": ["POL-REM-01"], "latency_s": 0.0038, "wall_s": 0.004, "api_calls": 0, "tool_calls": 2, "retries": 0, "usage": {}, "cost_usd": 0}
{"id": "pol-10", "rep": 0, "tags": ["policy_covered"], "prompt": "Is there a home office stipend?", "requester_id": "E016", "model": null, "status": "ok", "stop_reason": null, "grade": {"task_success": true, "wrong_action": false, "invented_policy": false, "outcome": "answer", "writes": [], "wrong_writes": [], "escalations": [], "blocked_attempts": 0, "must_escalate": false, "escalation_recall_hit": null, "false_escalation": false, "ungrounded_citations": [], "nonexistent_citations": [], "fail_reasons": []}, "reply": {"kind": "answer", "message": "Laptops and equipment: Every employee gets a company laptop, replaced every 3 years. A lost or stolen laptop or phone must be reported to IT within 24 hours so it can be locked and wiped; the helpdesk escalates these to IT. Full-time employees can claim a one-time home-office stipend of up to $300 through expenses. Personal devices may access email and team chat only, through the company app.", "cited_policy_ids": ["POL-EQP-01"]}, "writes_log": [], "policies_read": ["POL-EQP-01"], "latency_s": 0.0045, "wall_s": 0.005, "api_calls": 0, "tool_calls": 2, "retries": 0, "usage": {}, "cost_usd": 0}
{"id": "pol-11", "rep": 0, "tags": ["policy_covered"], "prompt": "How long do I have to submit an expense report?", "requester_id": "E030", "model": null, "status": "ok", "stop_reason": null, "grade": {"task_success": true, "wrong_action": false, "invented_policy": false, "outcome": "answer", "writes": [], "wrong_writes": [], "escalations": [], "blocked_attempts": 0, "must_escalate": false, "escalation_recall_hit": null, "false_escalation": false, "ungrounded_citations": [], "nonexistent_citations": [], "fail_reasons": []}, "reply": {"kind": "answer", "message": "Expenses: Submit expenses in the HR portal within 30 days, with a receipt for anything over $25. Meals while travelling are covered up to $75 per day. Your manager approves expenses; a single expense over $1,000 also needs your department head. Alcohol is not reimbursed unless it is part of an approved client event.", "cited_policy_ids": ["POL-EXP-01"]}, "writes_log": [], "policies_read": ["POL-EXP-01"], "latency_s": 0.0026, "wall_s": 0.003, "api_calls": 0, "tool_calls": 2, "retries": 0, "usage": {}, "cost_usd": 0}
{"id": "pol-14", "rep": 0, "tags": ["policy_covered"], "prompt": "Can I fly premium economy to the Frankfurt conference? It's an 8-hour flight.", "requester_id": "E021", "model": null, "status": "ok", "stop_reason": null, "grade": {"task_success": true, "wrong_action": false, "invented_policy": false, "outcome": "answer", "writes": [], "wrong_writes": [], "escalations": [], "blocked_attempts": 0, "must_escalate": false, "escalation_recall_hit": null, "false_escalation": false, "ungrounded_citations": [], "nonexistent_citations": [], "fail_reasons": []}, "reply": {"kind": "answer", "message": "Business travel: Book flights and hotels through the travel desk at least 14 days ahead where possible. Economy class for flights under 6 hours; premium economy is allowed for longer flights. Travel needs your manager's approval before booking.", "cited_policy_ids": ["POL-TRV-01"]}, "writes_log": [], "policies_read": ["POL-TRV-01"], "latency_s": 0.0027, "wall_s": 0.003, "api_calls": 0, "tool_calls": 2, "retries": 0, "usage": {}, "cost_usd": 0}
